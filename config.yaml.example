# Configuration for Bibliographic Extractor
# Copy this file to config.yaml and edit with your settings:
#   cp config.yaml.example config.yaml

# Your Anthropic API key
# Get one at: https://console.anthropic.com/settings/keys
anthropic_api_key: "sk-ant-api03-REPLACE_WITH_YOUR_KEY"

# Paths
pdf_in_folder: "./pdf-in" # Incoming PDFs to process
pdf_out_folder: "./pdf-out" # Processed PDFs moved here
main_bib_file: "~/Desktop/biblio-staging.bib"
failed_bib_file: "~/Desktop/biblio-failed.bib"
template_file: "./biblio-template.bib"
claude_md_file: "./CLAUDE.md"
ref_file: "./biblatex-chicago-notes-ref.md"  # Optional: condensed biblatex-chicago field reference

# Optional worked-example corpora, cached as part of the static prompt prefix.
# These teach entry-TYPE discrimination (why @Inproceedings and not
# @Incollection) rather than field vocabulary. Both are derived from the
# biblatex-chicago package's own documentation; notes-test.bib carries an
# `annote` on nearly every entry explaining the choice of type and fields.
# Comment out to reduce the cached prefix size.
example_files:
  - path: "./notes-test.bib"
    label: "biblatex-chicago annotated test suite"
  - path: "./cms-notes-intro-guide.md"
    label: "biblatex-chicago entry-type guide"

# Processing options
ocr_threshold: 100 # Minimum words extracted before OCR is attempted on key pages
ocr_timeout: 180 # Seconds to allow ocrmypdf on the extracted page subset before giving up
max_tokens: 4000 # Maximum tokens for Claude response
model: "claude-sonnet-4-20250514" # Claude model to use

# Prompt cache TTL for the shared static context. "1h" costs 2x base input to
# write (vs 1.25x for the 5-minute default) but survives between separate
# Quick Action invocations, which is the cheaper trade unless you always
# process files in one large batch. Set to "5m" for the short tier, or to an
# empty value to use the API default.
cache_ttl: "1h"
default_ocr_language: "eng"  # Tesseract language code used in quiet/automation mode (eng, rus, deu, fra, etc.)

# Enrichment: fill in fields the PDF itself doesn't contain (volume, issue,
# page range, chapter) via CrossRef and/or Google Scholar (ScrapingDog).
# Entries still missing required fields afterward are saved with a leading
# "% INCOMPLETE: ..." comment rather than blocked.
enrich_missing_fields: true
crossref_email: "" # Optional: your email, for CrossRef's "polite pool" (faster, more reliable)
scrapingdog_api_key: "" # Optional: ScrapingDog API key for Google Scholar fallback lookups (paid, https://scrapingdog.com)

# Logging
verbose: true
notifications: false  # Send macOS notifications (batch progress updates and validation failures)
show_window: false  # Show floating progress window (overridden by --window / --no-window flags)

# BibDesk integration
autofile_bibdesk: false  # After saving each entry, import it into BibDesk and auto-file the linked PDF.
                         # BibDesk will be launched and the bib file opened automatically if needed.
