% --- @Thesis vs @Report (see Kassler1975 above) vs @Unpublished (see
% Ingenious1973b below): a dissertation submitted to a degree-granting
% institution. Type = {\bibstring{phdthesis}} - the package's paired
% identifier for a doctoral thesis (mirroring the @phdthesis entry-type
% alias); use \bibstring{mastersthesis} for an MA/MSc thesis, not a literal
% English phrase. Institution holds the degree-granting university; do NOT
% add Address/Location for a thesis (Chicago cites "PhD diss., University X,
% year" with no separate city). NB `address` is an alias for `location` (a
% city), NOT for `institution` - and `school` is the legacy BibTeX alias for
% `institution`. This project uses `institution` and `location` only. ---
@thesis{Best1988,
	Author = {Best, Walther},
	Title = {\foreignlanguage{ngerman}{Die Romanzen Robert Schumanns}},
	Type = {\bibstring{phdthesis}},
	Date = {1988},
	Institution = {Universität Hamburg},
	Langid = {ngerman},
}

% --- @Unpublished vs @Thesis/@Report (see Best1988/Kassler1975 above): a
% forthcoming, not-yet-published work - names substituted for
% confidentiality. NB the "forthcoming" state is encoded here via Note
% rather than the package's own `pubstate = {forthcoming}` field; confirm
% whether that's a deliberate convention before treating it as the pattern
% to follow elsewhere. ---
@unpublished{Ingenious1973b,
	Author = {Ingenious, N.~A.},
	Title = {The Art of Pedaling},
	Editor = {Author, Some},
	Translator = {Lingual, Multi},
	Date = {1973},
	Edition = {2},
	Langid = {english},
	Note = {\autocap{f}orthcoming},
}

