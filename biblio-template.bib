% --- @Report vs @Thesis vs @Unpublished (see Best1988 below for the @Thesis
% comparison): an institutional technical report, not a degree submission -
% Type = {\bibstring{techreport}} (or bare `techreport`) uses the package's
% auto-detected bibstring rather than a literal English phrase, per its
% type-field auto-detection for manual/patent/report/thesis entries. ---
@report{Kassler1975,
	Author = {Kassler, Michael},
	Title = {Proving Musical Theorems I},
	Subtitle = {The Middleground of Heinrich Schenker's Theory of Tonality},
	Type = {\bibstring{techreport}},
	Number = {103},
	Date = {1975},
	Institution = {Basser Dept.\ of Computer Science, School of Physics, The University of Sydney},
	Location = {Sydney},
}


% --- Example book review type ---
% Fields: author, date, doi, journaltitle, number, pages, shorttitle, title, url, volume
% Note the use of \bibstring{reviewof} followed by the title of the reviewed book within `\mkbibemph{...}`, followed by comma, followed by `\bibstring{by}`, followed by the name of the book author (not the review author).
% Title/Subtitle COUNTEREXAMPLE: the colon here belongs to the REVIEWED work's
% title, inside \mkbibemph{}. It is not this entry's own title/subtitle
% boundary, so it must not be split out into a Subtitle field.
@review{Dunsby1997,
	Author = {Dunsby, Jonathan},
	Title = {\bibstring{reviewof} \mkbibemph{Authenticities: Philosophical Reflections on Musical Performance}, \bibstring{by} Peter Kivy},
	Journaltitle = {Music \& Letters},
	Date = {1997},
	Keywords = {crit-authenticity-realism},
	Shorttitle = {\bibstring{reviewof} \mkbibemph{Authenticities}, \bibstring{by} Kivy},
	Pages = {132-135},
	Volume = {78},
	Number = {1},
}

