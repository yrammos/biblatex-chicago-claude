% --- Title/Subtitle split. The colon-separated subtitle goes in its own
% Subtitle field, WITHOUT the colon - biblatex-chicago supplies the colon and
% applies Chicago capitalisation to each part separately. No Shorttitle is
% needed: short notes fall back to Title, which now excludes the subtitle. ---
@article{Dunsby1999,
	Author = {Dunsby, Jonathan},
	Title = {Recent Schenker},
	Subtitle = {The Poetic Power of Intelligent Calculation (or, the Emperor's Second Set of New Clothes)},
	Journaltitle = {Music Analysis},
	Date = {1999},
	Volume = {18},
	Number = {2},
	Pages = {263-273},
	Url = {http://dx.doi.org/10.1111/1468-2249.00093},
	Doi = {10.1111/1468-2249.00093},
}

