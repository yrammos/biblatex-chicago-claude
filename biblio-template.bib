% Minimal BibLaTeX-Chicago template
% One example per entry type, showing all available fields
% Generated from biblio-template.bib

% --- Generic article ---
@article{Adorno2005,
	Author = Xxxxx,
	Title = Xxxxx,
	Shorttitle = Xxxxx,
	Translator = Xxxxx,
	Journaltitle = Xxxxx,
	Volume = Xxxxx,
	Number = Xxxxx,
	Pages = Xxxxx,
	Date = Xxxxx,
	Url = Xxxxx,
	Doi = Xxxxx,
	Keywords = Xxxxx,
	Read = Xxxxx,
}

