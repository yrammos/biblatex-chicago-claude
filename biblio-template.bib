	Title = Xxxxx,
	Shorttitle = Xxxxx,
	Booktitle = Xxxxx,
	Editor = Xxxxx,
	Translator = Xxxxx,
	Chapter = Xxxxx,
	Date = Xxxxx,
	Origdate = Xxxxx,
	Location = Xxxxx,
	Publisher = Xxxxx,
	Keywords = Xxxxx,
	Read = Xxxxx,
}

% --- @Incollection vs @Inproceedings (see the discriminator note on
% Kretschmer2008 below): a reprinted essay in a general edited anthology (a
% "Library of Essays" reprint series), with no named conference behind it -
% an edited container alone doesn't make it @Inproceedings. ---
@incollection{Dreyfus2011,
	Author = {Dreyfus, Laurence},
	Title = {Early Music Defended Against Its Devotees},
	Subtitle = {A Theory of Historical Performance in the Twentieth Century},
	Booktitle = {Baroque Music},
	Editor = {Walls, Peter},
	Translator = {Weber, Samuel and Weber, Shierry},
	Series = {The Library of Essays in Music Performance Practice},
	Chapter = {29},
	Date = {2011},
	Location = {Abingdon},
	Publisher = {Routledge},
}

% --- @Inproceedings vs @Incollection discriminator: this paper was presented
% at a named conference (5. Kongress der Gesellschaft für Musiktheorie,
% Hamburg 2005) AND collected into a titled, published proceedings volume
% (Booktitle = the volume's own title, Booktitleaddon = the conference name/
% location) - that published proceedings volume is what makes it
% @Inproceedings rather than @Incollection. Compare to Dreyfus2011 above,
% a chapter in a general edited anthology with no named conference behind it.
% ALSO a Title/Subtitle COUNTEREXAMPLE: the two halves are joined by the
% quoted question's own question mark, not a colon. Splitting them would make
% biblatex insert a colon that isn't in the source, so the title stays whole
% and Shorttitle is retained to abbreviate it. ---
@inproceedings{Kretschmer2008,
	Author = {Kretschmer, Hans-Ulrich},
	Title = {\foreignlanguage{ngerman}{\mkbibquote{Phänomenologie oder abstraktes Eigenleben einer Idee?} Schenker-Analyse versus harmonische Schichtenreduktion}},
	Shorttitle = {\foreignlanguage{ngerman}{Schenker-Analyse versus harmonische Schichtenreduktion}},
	Booktitle = {\foreignlanguage{ngerman}{Musiktheorie im Kontext}},
	Booktitleaddon = {\foreignlanguage{ngerman}{5. Kongress der Gesellschaft für Musiktheorie, Hamburg 2005}},
	Editor = {Sprick, Jan Philipp and Bahr, Reinhard and Troschke, Michael von},
	Number = {9},
	Series = {Musik und},
	Pages = {85-98},
	Date = {2008},
	Location = {Berlin},
	Publisher = {Weidler},
	Langid = {ngerman},
}

