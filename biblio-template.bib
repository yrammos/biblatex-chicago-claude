	Author = Xxxxx,
	Title = Xxxxx,
	Titleaddon = Xxxxx,
	Shorttitle = Xxxxx,
	Year = Xxxxx,
	Month = Xxxxx,
	Publisher = Xxxxx,
	Doi = Xxxxx,
	Eprint = Xxxxx,
	Isbn = Xxxxx,
	Keywords = Xxxxx,
	Abstract = Xxxxx,
}

% --- @Collection vs @Proceedings (see Torsello2009 below): a general edited
% anthology, not a conference volume - same discriminator as @Incollection
% vs @Inproceedings, applied to the whole-volume case. Also demonstrates
% citing one volume of a multi-volume edited work via Maintitle/Volume/
% Volumes rather than a separate @MvCollection entry - Title holds this
% volume's own title, Maintitle the overall multi-volume work's title. ---
@collection{Bent1994,
	Title = {Fugue, Form and Style},
	Maintitle = {Music Analysis in the Nineteenth Century},
	Editor = {Bent, Ian},
	Volume = {1},
	Volumes = {2},
	Series = {Cambridge Readings in the Literature of Music},
	Date = {1994},
	Location = {Cambridge},
	Publisher = {Cambridge University Press},
}

% --- Generic inbook type ---
% Fields: author, booktitle, chapter, date, editor, location, origdate, publisher, read, shorttitle, title, translator
@inbook{Bach1753a,
