% Minimal BibLaTeX-Chicago template.
% One example per entry type, showing the fields that type takes.
%
% Generated by dev/build_template.py from real entries in biblio.bib, stripped
% of BibDesk and DEVONthink bookkeeping (bdsk-file, bdsk-url, local-url,
% remote-url, devonthink, date-added, date-modified, rating, read, reference)
% and of the fields the guidelines forbid (keywords).
%
% This file doubles as the regression fixture: bib_normalize.py must report
% 0 edits against it, and it must compile without biber warnings. Rerun the
% generator after a rule change and diff.
%
% NOTE: avoid the at-sign in these comments. A BibTeX parser reads it as the
% start of an entry even on a comment line.

% --- Generic article ---
% Date as an ISO 8601-2 range (solidus); Volume as an en-dash range;
% Title/Subtitle split; nested \mkbibemph, \mkbibquote and \foreignlanguage;
% Pages with a single hyphen.
@article{Marvin2012,
	Author = {Marvin, William},
	Date = {2012/2013},
	Journaltitle = {Dutch Journal of Music Theory},
	Langid = {ngerman},
	Pages = {221-240},
	Subtitle = {Schenker, Sonata Theory, and the Problem of the Recapitulation},
	Title = {\mkbibemph{\mkbibquote{\foreignlanguage{ngerman}{Und so weiter}}}},
	Volume = {37--38},
}

% --- Book ---
% Earned Shorttitle: the title carries TWO top-level colons, so which is the
% entry's own boundary is ambiguous and the splitter declines. Url kept
% because there is no Doi.
@book{Czerny1839,
	Author = {Czerny, Carl},
	Date = {1970},
	Editor = {Badura-Skoda, Paul},
	Location = {Wien},
	Origdate = {1839},
	Publisher = {Universal Edition},
	Subtitle = {Reminiscences of Beethoven, and, Chapters II and III from Volume IV of the Complete Theoretical and Practical Piano Forte School: Op.\,500},
	Title = {On the Proper Performance of All Beethoven's Works for the Piano},
	Url = {http://www.koelnklavier.de/quellen/czer-op500/00-einl.html},
}

% --- Chapter within a book ---
% Doi present, therefore no Url; Title/Subtitle split; Pages with a single
% hyphen.
@inbook{Tan2023,
	Author = {Tan, Daphne},
	Booktitle = {Explorations in Music and Esotericism},
	Date = {2023},
	Doi = {10.2307/jj.285035.9},
	Editor = {Roth, Marjorie and George, Leonard},
	Location = {London},
	Pages = {78-98},
	Publisher = {Boydell \& Brewer},
	Subtitle = {Victor Zuckerkandl at Eranos},
	Title = {Music Analysis as Esoteric Activity},
}

% --- Article in a reference work ---
% Online reference work: Entrysubtype, Url and Urldate are required
% together. The work goes in Title, the article in Lista.
@inreference{Marston2001,
	Author = {Marston, Nicholas},
	Date = {2001},
	Lista = {Autograph},
	Location = {New York},
	Publisher = {Oxford University Press},
	Title = {Grove Music Online},
	Url = {http://www.oxfordmusiconline.com/},
}

% --- Miscellaneous item ---
% \foreignlanguage wrapping a whole non-name field; \mkbibquote; Langid;
% Entrysubtype.
@misc{SchumannSchenkerBittendes,
	Author = {Schumann, Robert},
	Entrysubtype = {music},
	Langid = {ngerman},
	Note = {Ernst Oster Collection, ZB-2237 (reel 43, file 90)},
	Organization = {New York Public Library},
	Title = {\foreignlanguage{ngerman}{\mkbibquote{Bittendes Kind}}},
	Titleaddon = {printed score with annotations in Schenker's hand},
}

% --- Musical score ---
% Series carries the series name alone; the division that the imprint page
% attaches to it goes in Number, which is what makes the punctuation between
% the two come out right.
@music{Johansen2018,
	Date = {2018},
	Editor = {Johansen, Ken},
	Number = {Walkthrough and Study Editions},
	Publisher = {Informance},
	Series = {From the Ground Up},
	Title = {Nocturne in E-flat major (Op.~9, no.~2)},
}

% --- Online-only source ---
% A title whose colon is sealed inside \foreignlanguage: the splitter
% declines it, so the split was made by hand and BOTH halves carry their own
% wrapper. Shorttitle then falls away. Url and Urldate, which an Online
% entry must carry.
@online{Deliege2009,
	Author = {Deliège, Célestin},
	Langid = {french},
	Organization = {\foreignlanguage{french}{Université de Paris-Sorbonne}},
	Subtitle = {\foreignlanguage{french}{La \mkbibemph{Rêverie} des \mkbibemph{Scènes d'enfant} de Schumann}},
	Title = {\foreignlanguage{french}{Une illustration de la perspective analytique du modèle schenkérien}},
	Url = {http://www.plm.paris-sorbonne.fr/SchenkerMaster/Deliege.pdf},
	Urldate = {2009-11-20},
}

% --- Whole issue of a periodical ---
% Number as an en-dash range -- a literal field, so the separator typed is
% the one that reaches the page; Issuetitle.
@periodical{Sofer2025,
	Date = {2025},
	Editor = {Sofer, Daniele Shlomit},
	Issuetitle = {Colloquy Review: Philip Ewell, On Music Theory, and Making Music More Welcoming for Everyone},
	Number = {2--3},
	Title = {Journal of Musicological Research},
	Volume = {44},
}

% --- Reference work cited as a whole ---
% Earned Shorttitle via a sealed colon, in Greek; name components wrapped
% individually so the editor still inverts.
@reference{Vasdekis,
	Editor = {\foreignlanguage{greek}{Βασδέκης}, \foreignlanguage{greek}{Σταύρος Ν.}},
	Langid = {greek},
	Location = {\foreignlanguage{greek}{Σέρρες}},
	Publisher = {\foreignlanguage{greek}{\autocap{έ}κδοση του συγγραφέα}},
	Subtitle = {\foreignlanguage{greek}{Το σύνολο της ελληνικής γλώσσας καταταγμένο σε 20 πρωταρχικές ρίζες}},
	Title = {\foreignlanguage{greek}{Ετυμολογικό λεξικό της ελληνικής γλώσσας}},
}

% --- Introduction, preface or afterword to a book ---
% Bookauthor distinct from Author; Pages.
@suppbook{Gollin2011a,
	Author = {Gollin, Edward and Rehding, Alexander},
	Date = {2011},
	Location = {Oxford},
	Pages = {579-581},
	Publisher = {Oxford University Press},
	Title = {The Oxford Handbook of Neo-Riemannian Music Theories},
	Type = {glossary in},
}

% --- Introduction, preface or afterword to a collection ---
% Editora with Editoratype; Title/Subtitle split.
@suppcollection{Hampe,
	Author = {Hampe, Beate},
	Date = {2005},
	Editor = {Hampe, Beate},
	Editora = {Grady, Joseph~E.},
	Editoratype = {collaborator},
	Introduction = {X},
	Location = {Berlin},
	Pages = {1-12},
	Publisher = {Mouton de Gruyter},
	Series = {Cognitive Linguistics Research},
	Subtitle = {Image Schemas in Cognitive Linguistics},
	Title = {From Perception to Meaning},
}

% --- Book, second example -- foreign name components ---
% Both Author and Editor have every name component wrapped separately, so
% biber still parses surname from forenames and the editor inverts.
% Editortype and Series are wrapped as whole fields, which is correct for
% non-name fields.
@book{Aleksandrova2015,
	Author = {\foreignlanguage{russian}{Александрова}, \foreignlanguage{russian}{Н.~А.}},
	Date = {2015},
	Editor = {\foreignlanguage{russian}{Людько}, \foreignlanguage{russian}{М.~Г.}},
	Editortype = {\foreignlanguage{russian}{научный редактор}},
	Langid = {russian},
	Location = {\foreignlanguage{russian}{СПб.}},
	Pages = {352},
	Publisher = {\foreignlanguage{russian}{Издательство «Лань»; Издательство «ПЛАНЕТА МУЗЫКИ»}},
	Series = {\foreignlanguage{russian}{Учебники для вузов. Специальная литература}},
	Title = {\foreignlanguage{russian}{Вокал. Краткий словарь терминов и понятий}},
}

% --- Video recording ---
% Type; Editortype; Origdate beside Date; Langid.
@video{Argerich2008,
	Author = {Argerich, Martha},
	Date = {2008},
	Editor = {Gachot, Georges},
	Editortype = {director},
	Langid = {french},
	Origdate = {2003},
	Publisher = {\foreignlanguage{french}{Idéale Audience Internationale}},
	Title = {\foreignlanguage{french}{Conversation nocturne}},
	Type = {DVD},
}
