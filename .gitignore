# Local configuration (contains API key)
config.yaml

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Editor/tool local config
CLAUDE_md_ltex.json
.claude/settings.local.json

# Machine-specific Automator script (copy from automator/script.sh.example)
automator/script.sh

# LaTeX build artifacts from template test compiles
prompt-context/out/

# Real (often copyrighted) sources for the evaluation harness - the manifest
# describing them is tracked; the files themselves are not. See
# dev/eval/sample/README.md.
dev/eval/sample/*.pdf
dev/eval/sample/*.webloc

# select_sample.py's input: a stripped copy of the library, kept out of the
# repository because it quotes it - same convention as
# dev/normalization-plan.md's changelog files. Placed by hand; see
# dev/eval/README.md.
dev/eval/biblio.bib

# run.py's per-run save of every produced entry (dev/eval/README.md) -
# regenerated by the next live run, and --rescore is what reads it back.
dev/eval/last-run/
