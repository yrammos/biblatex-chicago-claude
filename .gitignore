# Local configuration (contains API key)
config.yaml

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Editor/tool local config
CLAUDE_md_ltex.json
.claude/settings.local.json

# Machine-specific Automator script (copy from automator/script.sh.example)
automator/script.sh

# LaTeX build artifacts from template test compiles
prompt-context/out/

# Real (often copyrighted) sources for the evaluation harness - the manifest
# describing them is tracked; the files themselves are not. See
# dev/eval/sample/README.md.
dev/eval/sample/*.pdf
dev/eval/sample/*.webloc
